generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  username      String    @unique
  bio           String?
  avatarUrl     String?
  role          String    @default("user")
  isBanned      Boolean   @default(false)
  banReason     String?
  bannedAt      DateTime?
  bannedById    String?
  googleId      String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  bannedBy           User?               @relation("BannedByUser", fields: [bannedById], references: [id])
  bannedUsers        User[]              @relation("BannedByUser")
  games              Game[]              @relation("GameCreatedBy")
  gameVersions       GameVersion[]
  reviews            Review[]            @relation("ReviewAuthor")
  flaggedReviews     Review[]            @relation("ReviewFlaggedBy")
  verificationTokens VerificationToken[]
  favorites          Favorite[]
  forumThreads       ForumThread[]       @relation("ForumThreadAuthor")
  forumPosts         ForumPost[]         @relation("ForumPostAuthor")
  reviewVotes        ReviewVote[]

  @@map("users")
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model Genre {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  gameGenres GameGenre[]

  @@map("genres")
}

model Game {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  description    String
  releaseYear    Int
  developer      String?
  publisher      String?
  qualityTier    String?
  youtubeVideoId String?
  coverImageUrl  String?
  purchaseLinks  Json      @default("[]")
  avgRating      Float     @default(0)
  reviewCount    Int       @default(0)
  isPublished    Boolean   @default(false)
  igdbId         Int?      @unique @map("igdb_id")
  lockedFields   String[]  @default([]) @map("locked_fields")
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdBy    User?         @relation("GameCreatedBy", fields: [createdById], references: [id])
  gameGenres   GameGenre[]
  versions     GameVersion[]
  reviews      Review[]
  favorites    Favorite[]
  forumThreads ForumThread[]

  @@index([avgRating(sort: Desc)])
  @@index([releaseYear])
  @@index([qualityTier])
  @@index([isPublished])
  @@map("games")
}

model GameGenre {
  gameId  String
  genreId String

  game  Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([gameId, genreId])
  @@index([genreId])
  @@map("game_genres")
}

model GameVersion {
  id           String   @id @default(uuid())
  gameId       String
  versionLabel String
  releaseDate  DateTime
  notes        String?
  createdById  String?
  createdAt    DateTime @default(now())

  game      Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([gameId])
  @@map("game_versions")
}

model Review {
  id              String    @id @default(uuid())
  gameId          String
  userId          String
  rating          Int
  body            String?
  isFlagged       Boolean   @default(false)
  flaggedById     String?
  flagReason      String?
  flaggedAt       DateTime?
  helpfulCount    Int       @default(0)
  notHelpfulCount Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  game      Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User         @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  flaggedBy User?        @relation("ReviewFlaggedBy", fields: [flaggedById], references: [id])
  votes     ReviewVote[]

  @@unique([gameId, userId])
  @@index([gameId])
  @@index([userId])
  @@map("reviews")
}

model ReviewVote {
  userId    String
  reviewId  String
  value     Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
  @@index([reviewId])
  @@map("review_votes")
}

model Favorite {
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@index([userId])
  @@map("favorites")
}

model ForumThread {
  id         String    @id @default(uuid())
  title      String
  body       String
  category   String
  authorId   String
  gameId     String?
  isPinned   Boolean   @default(false)
  isLocked   Boolean   @default(false)
  lastPostAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  author User        @relation("ForumThreadAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  game   Game?       @relation(fields: [gameId], references: [id], onDelete: SetNull)
  posts  ForumPost[]

  @@index([category])
  @@index([gameId])
  @@index([lastPostAt(sort: Desc)])
  @@index([authorId])
  @@map("forum_threads")
}

model ForumPost {
  id        String    @id @default(uuid())
  body      String
  threadId  String
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User        @relation("ForumPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([authorId])
  @@map("forum_posts")
}

model IgdbSyncState {
  id             Int       @id
  lastSyncedAt   Int       @default(0) @map("last_synced_at")
  accessToken    String?   @map("access_token")
  tokenExpiresAt DateTime? @map("token_expires_at")

  @@map("igdb_sync_state")
}

model RateLimitLog {
  id         String   @id @default(uuid())
  identifier String
  action     String
  createdAt  DateTime @default(now())

  @@index([identifier, action, createdAt(sort: Desc)])
  @@map("rate_limit_log")
}
